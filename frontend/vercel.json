{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/health/",
      "destination": "/api/proxy?path=health/"
    },
    {
      "source": "/api/v1/auth/login/",
      "destination": "/api/proxy?path=auth/login/"
    },
    {
      "source": "/api/v1/auth/refresh/",
      "destination": "/api/proxy?path=auth/refresh/"
    },
    {
      "source": "/api/v1/auth/eu/",
      "destination": "/api/proxy?path=auth/eu/"
    },
    {
      "source": "/api/v1/auth/logout/",
      "destination": "/api/proxy?path=auth/logout/"
    },
    {
      "source": "/painel",
      "destination": "/api/painel?path=painel/"
    },
    {
      "source": "/painel/:path*",
      "destination": "/api/painel?path=painel/:path*"
    },
    {
      "source": "/backoffice",
      "destination": "/api/painel?path=backoffice/"
    },
    {
      "source": "/backoffice/:path*",
      "destination": "/api/painel?path=backoffice/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "/api/painel?path=static/:path*"
    },
    {
      "source": "/entrar",
      "destination": "/app/login.html"
    }
  ]
}
